# Copie este archivo como ".env" y ponga sus datos. El archivo .env no se sube al repositorio.

# Conexión a PostgreSQL: postgresql://USUARIO:CLAVE@SERVIDOR:PUERTO/BASE
DATABASE_URL=postgresql://dj_app:cambie_esta_clave@localhost:5432/sistema_dj

# Esquema donde se crean las tablas (opcional; por defecto sistema_dj)
# DJ_SCHEMA=sistema_dj

# Clave que firma la cookie de sesión. En local puede omitirse: se genera sola en .clave_sesion.
# En un servidor defínala siempre (por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=

# Ponga 1 cuando la aplicación se sirva por HTTPS (la cookie solo viajará cifrada)
# COOKIE_SEGURA=1

# Base usada por las pruebas automáticas (opcional; si falta se usa DATABASE_URL).
# Las pruebas crean esquemas temporales "prueba_..." y los borran; no tocan sus datos.
# PRUEBAS_DATABASE_URL=postgresql://dj_app:cambie_esta_clave@localhost:5432/sistema_dj
